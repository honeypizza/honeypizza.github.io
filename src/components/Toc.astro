---
import type { MarkdownHeading } from 'astro';
import TocList from './post/TocList.astro';
import { buildToc, type TocItem } from './post/toc';

export interface Props {
  headings: MarkdownHeading[];
  /** mobile: 좁은 화면 위쪽에 붙는 접이식 막대 / desktop: 오른쪽 여백의 sticky 목록 */
  variant: 'mobile' | 'desktop';
  /** 이미 buildToc()로 만든 항목. 넘기면 다시 계산하지 않는다. */
  items?: TocItem[];
}

const { headings, variant, items = buildToc(headings) } = Astro.props;
---

{
  items.length > 0 &&
    (variant === 'mobile' ? (
      <details class="toc toc--mobile" data-toc>
        <summary>
          <span class="bar-label">
            <span data-toc-default>목차</span>
            <span class="bar-current" data-toc-current hidden>
              <span class="sr-only">목차, 지금 읽는 부분: </span>
              <span class="bar-num" aria-hidden="true" data-toc-num></span>
              <span class="bar-text" data-toc-text></span>
            </span>
          </span>
          <svg
            class="chevron"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M4 6l4 4 4-4" />
          </svg>
        </summary>
        <nav class="panel" aria-label="목차">
          <TocList items={items} />
        </nav>
      </details>
    ) : (
      <nav class="toc toc--desktop" aria-label="목차" data-toc>
        <TocList items={items} />
      </nav>
    ))
}

<style>
  /* 막대 높이. PostLayout이 이 값으로 --sticky-offset(anchor 이동 위치)을 정한다. */
  :global(:root) {
    --toc-bar-height: 2.75rem;
  }

  .toc {
    font-size: var(--text-sm);
  }

  /* Desktop: 오른쪽 여백에 붙어 따라온다. */
  .toc--desktop {
    position: sticky;
    top: var(--space-6);
    max-width: 240px;
    max-height: calc(100vh - var(--space-6) * 2);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  /* 좁은 화면: 화면 맨 위에 붙는 막대. 펼친 목록은 본문 위에 겹쳐 떠서 page가 밀리지 않는다. */
  .toc--mobile {
    /* 막대 안의 글자는 화면 가운데 본문 column에 맞춘다. */
    --toc-inline: max(var(--gutter), (100% - var(--width-prose)) / 2);
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--color-bg);
    border-block: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-height: var(--toc-bar-height);
    padding: var(--space-2) var(--toc-inline);
    list-style: none;
    cursor: pointer;
    user-select: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline-offset: -2px;
  }

  .bar-label {
    flex: 1;
    min-width: 0;
    font-weight: var(--weight-medium);
  }

  .bar-current:not([hidden]) {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    min-width: 0;
  }

  .bar-num {
    flex: none;
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-accent);
  }

  .bar-text {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .chevron {
    flex: none;
    color: var(--color-text-muted);
  }

  details[open] .chevron {
    rotate: 180deg;
  }

  @media (prefers-reduced-motion: no-preference) {
    .chevron {
      transition: rotate 0.2s ease;
    }
  }

  .panel {
    --toc-row-pad: var(--space-3);
    position: absolute;
    top: calc(100% + 1px);
    inset-inline: 0;
    max-height: calc(100vh - 4rem);
    max-height: calc(100dvh - 4rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0 var(--toc-inline) var(--space-2);
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-border);
  }

  /* JS가 없으면 붙지도 겹치지도 않는 평범한 접이식 목차. (script가 data-js를 붙인다) */
  .toc--mobile:not([data-js]) {
    position: static;
  }

  .toc--mobile:not([data-js]) .panel {
    position: static;
    max-height: none;
    overflow: visible;
    border-top: 1px solid var(--color-border);
    border-bottom: 0;
  }
</style>

<script>
  // 지금 읽는 section을 목차에 표시하고(aria-current), 좁은 화면 막대에 그 제목을 띄운다.
  const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-toc] a[href^="#"]')];
  const idOf = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
  const headings = [...new Set(links.map(idOf))]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => el !== null);

  const bar = document.querySelector<HTMLDetailsElement>('details[data-toc]');
  const barDefault = bar?.querySelector<HTMLElement>('[data-toc-default]');
  const barCurrent = bar?.querySelector<HTMLElement>('[data-toc-current]');
  const barNum = bar?.querySelector<HTMLElement>('[data-toc-num]');
  const barText = bar?.querySelector<HTMLElement>('[data-toc-text]');

  // heading 윗변이 화면 위에서 이만큼(px) 안으로 들어오면 그 section을 읽는 중으로 본다.
  const LINE = 120;
  let current: string | undefined;
  let ticking = false;

  function findCurrent() {
    // 읽기만 모아서 한 번에 한다 (쓰기는 update에서).
    let id: string | undefined;
    for (const heading of headings) {
      if (heading.getBoundingClientRect().top > LINE) break;
      id = heading.id;
    }
    // 끝까지 내렸으면 화면에 들어온 마지막 section을 고른다. (스크롤하기 전에는 아니다: 짧은 글은 처음부터 바닥이다)
    const last = headings.at(-1)!;
    const atBottom =
      window.scrollY > 0 && window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
    if (atBottom && last.getBoundingClientRect().top < window.innerHeight) id = last.id;
    return id;
  }

  function update() {
    ticking = false;
    const id = findCurrent();
    if (id === current) return;
    current = id;

    let active: HTMLAnchorElement | undefined;
    for (const link of links) {
      if (idOf(link) === id) {
        link.setAttribute('aria-current', 'location');
        active ??= link;
      } else {
        link.removeAttribute('aria-current');
      }
    }

    if (barDefault && barCurrent && barNum && barText) {
      barDefault.hidden = Boolean(active);
      barCurrent.hidden = !active;
      barNum.textContent = active?.querySelector('.num')?.textContent ?? '';
      barText.textContent = active?.querySelector('.text')?.textContent ?? '';
    }
  }

  if (headings.length > 0) {
    const schedule = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };
    window.addEventListener('scroll', schedule, { passive: true });
    window.addEventListener('resize', schedule, { passive: true });
    update();
  }

  if (bar) {
    // JS가 있을 때만 막대가 위에 붙고 목록이 본문 위에 겹친다 (CSS의 [data-js]).
    bar.dataset.js = '';

    // 항목을 고르면 접고, 초점을 그 제목으로 옮긴다. 스크롤은 브라우저의 anchor 이동에 맡긴다.
    bar.addEventListener('click', (event) => {
      const link = (event.target as Element).closest('a');
      if (!link) return;
      bar.open = false;
      const target = document.getElementById(idOf(link));
      if (target) {
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      }
    });
    // Esc, 바깥 클릭, 초점이 막대 밖으로 나가면 접는다. (펼친 목록이 초점 받은 곳을 가리지 않게)
    bar.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape' || !bar.open) return;
      bar.open = false;
      bar.querySelector('summary')?.focus();
    });
    bar.addEventListener('focusout', (event) => {
      const next = event.relatedTarget;
      if (bar.open && next instanceof Node && !bar.contains(next)) bar.open = false;
    });
    document.addEventListener('click', (event) => {
      if (bar.open && !bar.contains(event.target as Node)) bar.open = false;
    });
  }
</script>
