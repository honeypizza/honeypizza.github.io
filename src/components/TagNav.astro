---
/**
 * 목록 page의 태그 고르기. 태그를 누르면 그 태그가 붙은 글만 모은 page로 가고,
 * 그 page에서도 같은 자리에 이 목록이 있어 지금 고른 태그가 강조된다.
 * - 전체 글: 모든 태그. 태그 page는 /tags/<태그>/, "전체"는 /posts/
 * - 일상·공부: 그 분류 글의 태그만. 태그 page는 /posts/daily/tags/<태그>/, "전체"는 /posts/daily/
 * - 좁은 화면: 제목 아래 한 줄. 넘치면 옆으로 밀어서 본다.
 * - 넓은 화면(1152px~): 왼쪽 칸에서 여러 줄로.
 */
import { CATEGORIES, tagHref, type Category, type groupByTag } from '../lib/posts';

type TagGroup = ReturnType<typeof groupByTag>[number];

export interface Props {
  tags: TagGroup[];
  /** 이 목록이 다루는 글 수 ("전체" 옆 숫자) */
  total: number;
  /** 지금 보고 있는 태그의 주소 이름 (태그 page에서만) */
  current?: string;
  /** 일상·공부 page면 그 분류. 태그 링크가 그 분류 안의 태그 page로 간다. */
  category?: Category;
}

const { tags, total, current, category } = Astro.props;
const allHref = category ? CATEGORIES[category].href : '/posts/';
const onAll = Astro.url.pathname.replace(/\/?$/, '/') === allHref;
---

{
  tags.length > 0 && (
    <nav class="tag-nav" aria-labelledby="tag-nav-label">
      {/* 모든 태그 page(/tags/)는 전체 글 쪽에서만 연결한다. 일상·공부에서는 다른 분류의 태그가 섞여 보이지 않게. */}
      <p class="label" id="tag-nav-label">
        {category ? '태그' : <a href="/tags/">태그</a>}
      </p>
      <ul>
        <li>
          <a href={allHref} aria-current={onAll ? 'page' : undefined}>
            전체 <span class="count">{total}</span>
          </a>
        </li>
        {tags.map((tag) => (
          <li>
            <a href={tagHref(tag.label, category)} aria-current={current === tag.slug ? 'page' : undefined}>
              #{tag.label} <span class="count">{tag.posts.length}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

<style>
  .tag-nav {
    margin-top: var(--space-6);
  }

  /* 홈·목록의 section label과 같은 작고 조용한 글씨 */
  .label {
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-label);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .label a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .label a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  /* 좁은 화면: 한 줄로 늘어놓고 넘치면 옆으로 scroll */
  ul {
    display: flex;
    gap: 0 var(--space-4);
    margin-top: var(--space-1);
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }

  ul::-webkit-scrollbar {
    display: none;
  }

  li {
    flex-shrink: 0;
  }

  a {
    display: inline-block;
    padding-block: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  ul a:hover {
    color: var(--color-accent);
  }

  /* 지금 보고 있는 목록: 상단 메뉴의 현재 위치 표시와 같은 모양 */
  ul a[aria-current] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.4em;
  }

  /* scroll 영역 밖으로 나가면 잘리므로 focus ring을 안쪽에 그린다. */
  ul a:focus-visible {
    outline-offset: -2px;
  }

  .count {
    font-size: var(--text-label);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }

  @media (pointer: coarse) {
    a {
      padding-block: 0.625rem;
    }
  }

  /* 본문 단이 화면을 다 채우는 폭: 표처럼 scroll 영역을 화면 끝까지 넓혀 "옆으로 더 있다"는 것을 보여 준다 */
  @media (max-width: 759.98px) {
    ul {
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
  }

  /* 넓은 화면: 왼쪽 칸 안에서 여러 줄로 */
  @media (min-width: 1152px) {
    ul {
      flex-wrap: wrap;
      gap: 0 var(--space-4);
      overflow: visible;
    }

    a {
      padding-block: var(--space-1);
    }
  }
</style>
