---
---

<button type="button" class="theme-toggle" data-theme-toggle aria-label="다크 모드" aria-pressed="false">
  <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path
      d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
  </svg>
  <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"></circle>
    <path
      d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"></path>
  </svg>
</button>

<style>
  .theme-toggle {
    /* 손가락으로 누르는 화면에서는 44px. header가 이 값으로 아이콘 위치를 본문 끝에 맞춘다. */
    --toggle-size: 2.5rem;
    display: inline-grid;
    place-items: center;
    width: var(--toggle-size);
    height: var(--toggle-size);
    padding: 0;
    color: var(--color-text-muted);
    background: transparent;
    border: 0;
    border-radius: 50%;
    cursor: pointer;
  }

  .theme-toggle:hover {
    color: var(--color-accent);
  }

  @media (pointer: coarse) {
    .theme-toggle {
      --toggle-size: 2.75rem;
    }
  }

  /* light-dark() 미지원 browser는 색이 light로 고정되므로 toggle을 숨긴다. */
  @supports not (color: light-dark(#fff, #000)) {
    .theme-toggle {
      display: none;
    }
  }

  /* 지금 theme이 light면 달(→ dark로 전환), dark면 해(→ light로 전환)를 보여준다.
     head의 inline script가 data-theme을 먼저 붙이므로 처음 그릴 때부터 맞는 icon이 나온다. */
  .icon-sun {
    display: none;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .icon-sun {
      display: block;
    }
    :global(:root:not([data-theme='light'])) .icon-moon {
      display: none;
    }
  }

  :global(:root[data-theme='dark']) .icon-sun {
    display: block;
  }

  :global(:root[data-theme='dark']) .icon-moon {
    display: none;
  }
</style>

<script>
  const root = document.documentElement;
  const media = window.matchMedia('(prefers-color-scheme: dark)');
  const systemTheme = () => (media.matches ? 'dark' : 'light');
  const currentTheme = () => root.dataset.theme ?? systemTheme();

  function sync() {
    const pressed = String(currentTheme() === 'dark');
    document.querySelectorAll('[data-theme-toggle]').forEach((button) => button.setAttribute('aria-pressed', pressed));
    // 모바일 browser 상단 색도 지금 배경색에 맞춘다.
    const bg = getComputedStyle(document.body).backgroundColor;
    document.querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]').forEach((meta) => (meta.content = bg));
  }

  function save(theme: string | null) {
    try {
      if (theme) localStorage.setItem('theme', theme);
      else localStorage.removeItem('theme');
    } catch {}
  }

  document.querySelectorAll('[data-theme-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const next = currentTheme() === 'dark' ? 'light' : 'dark';
      // system 설정과 같은 쪽으로 돌아오면 저장값을 지워서 다시 system을 따르게 한다.
      if (next === systemTheme()) {
        delete root.dataset.theme;
        save(null);
      } else {
        root.dataset.theme = next;
        save(next);
      }
      sync();
    });
  });

  media.addEventListener('change', sync);
  sync();
</script>
