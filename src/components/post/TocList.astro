---
import type { TocItem } from './toc';

export interface Props {
  items: TocItem[];
}

const { items } = Astro.props;
---

<ol class="toc-list">
  {
    items.map((item) => (
      <li>
        <a href={`#${item.slug}`}>
          <span class="num" aria-hidden="true">{item.num}</span>
          <span class="text">{item.text}</span>
        </a>
        {item.children.length > 0 && (
          <ol>
            {item.children.map((child) => (
              <li>
                <a href={`#${child.slug}`}>
                  <span class="num" aria-hidden="true">{child.num}</span>
                  <span class="text">{child.text}</span>
                </a>
              </li>
            ))}
          </ol>
        )}
      </li>
    ))
  }
</ol>

<style>
  /* 번호 + 제목 한 줄씩, 항목 사이는 1px 선. 행 위아래 여백은 부모가 --toc-row-pad로 정한다. */
  ol {
    padding: 0;
    list-style: none;
  }

  a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: baseline;
    padding-block: var(--toc-row-pad, var(--space-2));
    border-top: 1px solid var(--color-border);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .toc-list > li:first-child > a {
    border-top: 0;
  }

  a:hover {
    color: var(--color-text);
  }

  a:focus-visible {
    outline-offset: -2px;
  }

  .num {
    font-size: var(--text-label);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .text {
    overflow-wrap: anywhere;
  }

  a[aria-current='location'] {
    color: var(--color-text);
  }

  /* 색만으로 구분하지 않도록 굵기도 바꾼다. */
  a[aria-current='location'] .text {
    font-weight: var(--weight-semibold);
  }

  a[aria-current='location'] .num {
    color: var(--color-accent);
  }
</style>
