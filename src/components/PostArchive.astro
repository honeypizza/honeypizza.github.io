---
import PostList from './PostList.astro';
import { CATEGORIES, getPosts, groupByYear, type Category, type Post } from '../lib/posts';

export interface Props {
  posts: Post[];
  /** 지금 보고 있는 tab. 없으면 "전체". */
  active?: Category;
  /** false면 tab 없이 연도별 목록만 보여 준다 (태그 페이지). */
  tabs?: boolean;
}

const { posts, active, tabs: showTabs = true } = Astro.props;

const all: Post[] = showTabs ? await getPosts() : [];
const tabs = [
  { key: undefined, label: '전체', href: '/posts/', count: all.length },
  ...(Object.keys(CATEGORIES) as Category[]).map((key) => ({
    key,
    label: CATEGORIES[key].label,
    href: CATEGORIES[key].href,
    count: all.filter((post) => post.data.category === key).length,
  })),
];

const years = groupByYear(posts);
---

{
  showTabs && (
    <nav class="tabs" aria-label="글 분류">
      <ul>
        {tabs.map((tab) => (
          <li>
            <a href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>
              {tab.label}{' '}<span class="count">
                {tab.count}
                <span class="sr-only">편</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </nav>
  )
}

{
  years.length === 0 ? (
    <p class="empty">아직 글이 없습니다.</p>
  ) : (
    years.map(({ year, posts }) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 class="year-label" id={`year-${year}`}>
          {year}{' '}<span class="count">{posts.length}편</span>
        </h2>
        <PostList posts={posts} dateStyle="short" showCategory={!active} />
      </section>
    ))
  )
}

<style>
  .tabs {
    margin-bottom: var(--space-7);
    border-bottom: 1px solid var(--color-border);
  }

  .tabs ul {
    display: flex;
    flex-wrap: wrap;
    column-gap: var(--space-5);
    padding: 0;
    list-style: none;
  }

  .tabs a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding-block: var(--space-3);
    margin-bottom: -1px;
    color: var(--color-text-muted);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .tabs a:hover {
    color: var(--color-accent);
  }

  .tabs a[aria-current='page'] {
    color: var(--color-text);
    font-weight: var(--weight-semibold);
    border-bottom-color: currentColor;
  }

  .count {
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .year + .year {
    margin-top: var(--space-8);
  }

  /* 연도 + 글 수, 그 아래 1px 선. 작고 조용한 section label. */
  .year-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
