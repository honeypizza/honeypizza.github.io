---
import PostList from './PostList.astro';
import { groupByYear, type Category, type Post } from '../lib/posts';

export interface Props {
  posts: Post[];
  /** 한 분류만 모은 page(일상, 공부)면 그 분류. 글마다 붙는 분류 표시를 뺀다. */
  category?: Category;
}

const { posts, category } = Astro.props;

const years = groupByYear(posts);
---

{
  years.length === 0 ? (
    <p class="empty">아직 글이 없습니다.</p>
  ) : (
    years.map(({ year, posts }) => (
      <section class="year" aria-labelledby={`year-${year}`}>
        <h2 class="year-label" id={`year-${year}`}>
          {year}{' '}<span class="count">{posts.length}편</span>
        </h2>
        <PostList posts={posts} dateStyle="short" showCategory={!category} />
      </section>
    ))
  )
}

<style>
  .count {
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  .year + .year {
    margin-top: var(--space-8);
  }

  /* 연도 + 글 수, 그 아래 1px 선. 작고 조용한 section label. */
  .year-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
