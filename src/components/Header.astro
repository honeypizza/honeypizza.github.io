---
import { NAV, SITE, type NavKey } from '../consts';
import ThemeToggle from './ThemeToggle.astro';

export interface Props {
  current?: NavKey;
}

const { current } = Astro.props;
const path = Astro.url.pathname.replace(/\/?$/, '/');

// 그 page에 있으면 'page', 글 page처럼 그 section 안에 있으면 'true'.
const ariaCurrent = (key: NavKey, href: string) => {
  if (path === href) return 'page';
  return key === current ? 'true' : undefined;
};
---

<header class="site-header">
  <div class="container inner">
    <a class="site-title" href="/">{SITE.title}</a>
    <nav class="site-nav" aria-label="주 메뉴">
      <ul>
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} aria-current={ariaCurrent(item.key, item.href)}>
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <ThemeToggle />
  </div>
</header>

<style>
  /* sticky가 아니다. 넓은 화면의 글 page에서는 왼쪽 칸(글 정보·목차)이 따라 내려온다. */
  .inner {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      'title toggle'
      'nav nav';
    align-items: center;
    row-gap: var(--space-1);
    padding-block: var(--space-3) var(--space-1);
  }

  .site-title {
    grid-area: title;
    justify-self: start;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    letter-spacing: var(--tracking-heading);
    text-decoration: none;
  }

  .site-nav {
    grid-area: nav;
    /* 좁은 화면에서 메뉴가 넘치면 가로로 밀어서 본다. */
    overflow-x: auto;
    margin-inline: calc(var(--space-2) * -1);
  }

  .site-nav ul {
    display: flex;
    padding: 0;
    list-style: none;
  }

  .site-nav a {
    display: block;
    padding: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    text-decoration: none;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--color-accent);
  }

  .site-nav a[aria-current] {
    color: var(--color-text);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.5em;
  }

  /* scroll 영역 밖으로 나가면 잘리므로 focus ring을 안쪽에 그린다. */
  .site-nav a:focus-visible {
    outline-offset: -2px;
  }

  /* 손가락으로 누르는 화면: 메뉴 높이를 44px 이상으로 */
  @media (pointer: coarse) {
    .site-nav a {
      padding-block: 0.625rem;
    }
  }

  /* 버튼은 아이콘(18px)보다 크므로, 그 차이의 절반만큼 밖으로 내서 아이콘 오른쪽 끝을 본문 오른쪽 끝에 맞춘다.
     (왼쪽의 logo 글자가 본문 왼쪽 끝에 맞는 것과 짝) */
  .inner > :global(.theme-toggle) {
    grid-area: toggle;
    margin-inline-end: calc((var(--toggle-size) - 18px) / -2);
  }

  /* 한 줄: logo | 메뉴 | 버튼. 한 줄에 필요한 폭은 약 410px이라 480px부터 한 줄로 둔다.
     (그보다 좁은 세로 휴대폰에서만 두 줄. 이 경계를 넓게 잡으면 그 폭에서 header 높이가 37px 바뀌며 page가 튄다) */
  @media (min-width: 480px) {
    .inner {
      grid-template-columns: 1fr auto auto;
      grid-template-areas: 'title nav toggle';
      column-gap: var(--space-3);
      min-height: 4rem;
      padding-block: var(--space-2);
    }

    .site-nav {
      overflow-x: visible;
      margin-inline: 0;
    }

    .site-nav ul {
      gap: var(--space-2);
    }
  }
</style>
