---
import { profile } from '../data/profile';

const year = new Date().getFullYear();
const github = profile.links.find((link) => link.label === 'GitHub');
---

<footer class="site-footer">
  <div class="container inner">
    <p>© {year} {profile.name}</p>
    <ul>
      <li><a href="/tags/">태그</a></li>
      {github && <li><a href={github.href}>GitHub</a></li>}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--section-gap);
    font-size: var(--text-sm);
    color: var(--color-text-muted);
  }

  /* header와 같은 좌우 끝선: 왼쪽 이름, 오른쪽 링크. 좁으면 줄을 바꾼다. */
  .inner {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-2) var(--space-5);
    /* 링크 hit 영역(위아래 8px)만큼 줄여서 전체 높이는 그대로 둔다. */
    padding-block: var(--space-5);
  }

  /* 위쪽 구분선은 다른 구분선처럼 내용 폭에만 긋는다 (container 좌우 여백 제외). */
  .inner::before {
    content: '';
    position: absolute;
    top: 0;
    inset-inline: var(--gutter);
    border-top: 1px solid var(--color-border);
  }

  ul {
    display: flex;
    gap: var(--space-4);
    padding: 0;
    list-style: none;
  }

  a {
    display: inline-block;
    padding-block: var(--space-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--color-accent);
  }
</style>
