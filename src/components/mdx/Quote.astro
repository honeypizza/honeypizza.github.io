---
/**
 * 출처가 있는 인용.
 *   <Quote name="이름" role="소속 · 직함">인용문</Quote>
 */
export interface Props {
  name: string;
  role?: string;
  /** 인용 출처 URL (선택) */
  cite?: string;
}

const { name, role, cite } = Astro.props;
---

<figure class="quote">
  <blockquote cite={cite}>
    <slot />
  </blockquote>
  <figcaption>
    <span class="name">{cite ? <a href={cite}>{name}</a> : name}</span>{
      role && (
        <span class="role">
          <span aria-hidden="true"> · </span>{role}
        </span>
      )
    }
  </figcaption>
</figure>

<style>
  /* 상자 없이 얇은 왼쪽 선 + 큰 serif 인용문 + 작은 출처 */
  .quote {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border-strong);
  }

  .quote blockquote {
    color: var(--color-text);
    font-family: var(--font-serif);
    font-size: var(--text-md);
    font-weight: var(--weight-regular);
    line-height: 1.7;
  }

  .quote blockquote > :global(* + *) {
    margin-top: var(--space-3);
  }

  /* serif 한글은 굵기 차이가 거의 없어서, 강조(*…*)는 글자 위 작은 점(드러냄표)으로 표시한다. */
  .quote blockquote :global(em) {
    -webkit-text-emphasis: filled dot var(--color-text-muted);
    text-emphasis: filled dot var(--color-text-muted);
    -webkit-text-emphasis-position: over right;
    text-emphasis-position: over right;
  }

  figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .name {
    font-weight: var(--weight-semibold);
    color: var(--color-text);
  }
</style>
