---
/**
 * 강조 박스.
 *   <Callout>참고할 내용</Callout>
 *   <Callout type="warning" title="꼭 확인하세요">주의할 내용</Callout>
 */
export interface Props {
  type?: 'note' | 'warning';
  title?: string;
}

const { type = 'note', title } = Astro.props;
const label = title ?? (type === 'warning' ? '주의' : '참고');
---

<div class:list={['callout', `callout--${type}`]} role="note">
  <p class="callout__title">{label}</p>
  <div class="callout__body"><slot /></div>
</div>

<style>
  /* 상자 없이 Quote처럼 얇은 왼쪽 선 + 작은 라벨. 주의는 선과 라벨을 글자색으로 진하게. */
  .callout {
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border-strong);
  }

  .callout--warning {
    border-left-color: var(--color-text);
  }

  .callout__title {
    margin-bottom: var(--space-1);
    font-size: var(--text-sm);
    font-weight: var(--weight-semibold);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .callout--warning .callout__title {
    color: var(--color-text);
  }

  .callout__body > :global(* + *) {
    margin-top: var(--space-3);
  }
</style>
