---
import type { InferGetStaticPropsType } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { SITE } from '../../consts';
import { getPosts, groupByTag } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = groupByTag(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.props;
const title = `#${tag.label}`;
---

<BaseLayout title={title} description={`${title} 태그가 붙은 글 ${tag.posts.length}편 — ${SITE.description}`}>
  <div class="container narrow">
    <header class="page-header">
      <h1>{title}</h1>
    </header>
    <PostArchive posts={tag.posts} />
  </div>
</BaseLayout>

<style>
  .page-header h1 {
    overflow-wrap: anywhere;
  }
</style>
