---
import type { InferGetStaticPropsType } from 'astro';
import ListLayout from '../../layouts/ListLayout.astro';
import { SITE } from '../../consts';
import { getPosts, groupByTag } from '../../lib/posts';

export async function getStaticPaths() {
  const tags = groupByTag(await getPosts());
  return tags.map((tag) => ({ params: { tag: tag.slug }, props: { tag } }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { tag } = Astro.props;
const title = `#${tag.label}`;
---

{/* 태그 page는 "전체 글"을 태그로 거른 목록이라 상단 메뉴에서도 전체 글 아래에 있는 것으로 표시한다. */}
<ListLayout
  title={title}
  description={`${title} 태그가 붙은 글 ${tag.posts.length}편 — ${SITE.description}`}
  current="posts"
  posts={tag.posts}
  currentTag={tag.slug}
/>
