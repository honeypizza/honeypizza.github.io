---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../consts';
import { getPosts, groupByTag, tagHref } from '../../lib/posts';

const title = '태그';
const tags = groupByTag(await getPosts());
---

<BaseLayout title={title} description={`글에 붙은 태그 ${tags.length}개 — ${SITE.description}`}>
  <div class="container narrow">
    <header class="page-header">
      <h1>{title}</h1>
    </header>

    {
      tags.length === 0 ? (
        <p class="empty">아직 태그가 없습니다.</p>
      ) : (
        /* 태그별 글 목록은 각 태그 page(/tags/<태그>/)에서 본다. */
        <ul class="tag-index">
          {tags.map((tag) => (
            <li>
              <a href={tagHref(tag.label)}>#{tag.label}</a>{' '}
              <span class="count">
                {tag.posts.length}
                <span class="sr-only">편</span>
              </span>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</BaseLayout>

<style>
  .count {
    font-size: var(--text-label);
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-label);
    color: var(--color-text-muted);
    font-variant-numeric: tabular-nums;
  }

  /* 태그 이름 + 글 수를 한 줄로 이어 쓴다. 상자 없이 간격으로만 나눈다. */
  .tag-index {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .tag-index li {
    display: flex;
    align-items: baseline;
    gap: 0.375rem;
    min-width: 0;
  }

  .tag-index a {
    overflow-wrap: anywhere;
    text-decoration: none;
  }

  .tag-index a:hover,
  .tag-index a:focus-visible {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .empty {
    color: var(--color-text-muted);
  }
</style>
