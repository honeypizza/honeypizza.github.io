---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { CATEGORIES, getPosts, type Category } from '../lib/posts';

/** 홈에 보여줄 category별 최근 글 수 */
const RECENT_COUNT = 5;

const sections = await Promise.all(
  (['tech', 'daily'] as Category[]).map(async (category) => {
    const posts = await getPosts(category);
    return { category, ...CATEGORIES[category], total: posts.length, posts: posts.slice(0, RECENT_COUNT) };
  }),
);
---

<BaseLayout current="home">
  <div class="container">
    <header class="hero">
      {/* 이름(h1)과 소개(p)를 한 문단처럼 이어서 보여 준다. */}
      <div class="statement">
        <h1>{profile.name}</h1>{' '}
        <p>{profile.shortIntro}</p>
      </div>
      <a class="text-link more" href="/about/">소개 더보기 <span aria-hidden="true">→</span></a>
    </header>

    <div class="recent">
      {
        sections.map((section) => (
          <section aria-labelledby={`recent-${section.category}`}>
            <h2 class="section-label" id={`recent-${section.category}`}>
              <a href={section.href}>최근 {section.label} 글</a>
              <span class="count">전체 {section.total}편</span>
            </h2>
            <div class="list">
              {section.posts.length > 0 ? (
                <PostList posts={section.posts} />
              ) : (
                <p class="empty">아직 글이 없습니다.</p>
              )}
            </div>
          </section>
        ))
      }
    </div>

    <p class="all">
      <a class="text-link" href="/posts/">전체 글 보기 <span aria-hidden="true">→</span></a>
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--section-gap);
  }

  .statement {
    max-width: var(--width-wide);
    font-family: var(--font-serif);
    font-size: var(--text-statement);
    font-weight: var(--weight-regular);
    line-height: var(--leading-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--color-text-muted);
    text-wrap: balance;
  }

  .statement h1,
  .statement p {
    display: inline;
    font: inherit;
    letter-spacing: inherit;
  }

  /* 이름은 같은 serif, 색으로만 구분한다. */
  .statement h1 {
    color: var(--color-text);
  }

  .more {
    display: inline-block;
    margin-top: var(--space-6);
  }

  /* 작은 라벨 + 개수 + 1px 선 */
  .section-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .section-label a {
    text-decoration: none;
  }

  .section-label a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .count {
    color: var(--color-text-muted);
  }

  /* 넓은 화면에서는 기술 | 일상 두 열 */
  .recent {
    display: grid;
    gap: var(--section-gap) var(--space-8);
  }

  .list {
    margin-top: var(--space-5);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .all {
    margin-top: var(--space-8);
  }

  @media (min-width: 960px) {
    .recent {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
