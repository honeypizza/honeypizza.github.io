---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { CATEGORIES, getPosts, type Category } from '../lib/posts';

/** 홈에 보여줄 category별 최근 글 수 */
const RECENT_COUNT = 5;

const sections = await Promise.all(
  // 상단 메뉴와 같은 순서: 일상 → 공부 (넓은 화면에서는 일상이 왼쪽)
  (['daily', 'study'] as Category[]).map(async (category) => {
    const posts = await getPosts(category);
    return { category, ...CATEGORIES[category], total: posts.length, posts: posts.slice(0, RECENT_COUNT) };
  }),
);
---

<BaseLayout current="home">
  <div class="container">
    <header class="hero">
      {/* 프로필: 사진(있을 때만) | 이름, 한 줄 소개, 링크. 내용은 src/data/profile.ts에서 고친다. */}
      <div class="profile">
        {
          profile.photo && (
            <Image class="avatar" src={profile.photo} alt={`${profile.name} 프로필 사진`} width={128} height={128} />
          )
        }
        <div class="identity">
          {/* 이름을 누르면 소개 페이지로 간다. */}
          <h1 class="name"><a href="/about/">{profile.name}</a></h1>
          <p class="tagline">{profile.tagline}</p>
          <ul class="links">
            {
              profile.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
            {/* 새 글 구독 (RSS 리더 앱용). 개인 연락처가 아니라서 profile.ts가 아닌 여기에 둔다. */}
            <li><a href="/rss.xml">RSS</a></li>
          </ul>
        </div>
      </div>
    </header>

    <div class="recent">
      {
        sections.map((section) => (
          <section aria-labelledby={`recent-${section.category}`}>
            <h2 class="section-label" id={`recent-${section.category}`}>
              <a href={section.href}>최근 {section.label} 글</a>
              <span class="count">전체 {section.total}편</span>
            </h2>
            <div class="list">
              {section.posts.length > 0 ? (
                <PostList posts={section.posts} />
              ) : (
                <p class="empty">아직 글이 없습니다.</p>
              )}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>

<style>
  /* 다른 page의 제목(.page-header)과 같은 위아래 여백 → 이름이 다른 page 제목과 같은 높이에서 시작한다. */
  .hero {
    padding-block: var(--section-gap) var(--space-7);
  }

  /* 사진 | 이름·한 줄 소개·링크. 상자 없이 배치만. */
  .profile {
    display: flex;
    align-items: center;
    gap: var(--space-5);
  }

  .avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .identity {
    min-width: 0;
  }

  /* 목록·소개 page 제목과 같은 크기 (글 제목만 --text-3xl) */
  .name {
    font-size: var(--text-2xl);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-tight);
  }

  .tagline {
    margin-top: var(--space-2);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .links a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .name a {
    color: inherit;
    text-decoration: none;
  }

  .name a:hover {
    color: var(--color-accent);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  /* 작은 라벨 + 개수 + 1px 선 */
  .section-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .section-label a {
    text-decoration: none;
  }

  .section-label a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .count {
    color: var(--color-text-muted);
  }

  /* 넓은 화면에서는 일상 | 공부 두 열 */
  .recent {
    display: grid;
    gap: var(--section-gap) var(--space-8);
  }

  .list {
    margin-top: var(--space-5);
  }

  .empty {
    color: var(--color-text-muted);
  }

  @media (min-width: 960px) {
    .recent {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
