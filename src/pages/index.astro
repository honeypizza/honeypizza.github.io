---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostList from '../components/PostList.astro';
import { profile } from '../data/profile';
import { CATEGORIES, getPosts, type Category } from '../lib/posts';

/** 홈에 보여줄 category별 최근 글 수 */
const RECENT_COUNT = 5;

const sections = await Promise.all(
  (['study', 'daily'] as Category[]).map(async (category) => {
    const posts = await getPosts(category);
    return { category, ...CATEGORIES[category], total: posts.length, posts: posts.slice(0, RECENT_COUNT) };
  }),
);
---

<BaseLayout current="home">
  <div class="container">
    <header class="hero">
      {/* 프로필 카드: 사진 | 이름, 한 줄 소개, 링크. 내용은 src/data/profile.ts에서 고친다. */}
      <div class="profile-card">
        {
          profile.photo ? (
            <Image class="avatar" src={profile.photo} alt={`${profile.name} 프로필 사진`} width={128} height={128} />
          ) : (
            /* 사진이 없으면 사이트 아이콘(public/favicon.svg와 같은 모양)을 둔다. */
            <span class="avatar avatar-mark" aria-hidden="true">
              <svg viewBox="0 0 32 32" width="28" height="28">
                <path class="ink" d="M4 8H14V18H24V28H4Z" />
                <rect class="sky" x="18" y="4" width="10" height="10" />
              </svg>
            </span>
          )
        }
        <div class="identity">
          <h1 class="name">{profile.name}</h1>
          <p class="tagline">{profile.tagline}</p>
          <ul class="links">
            {
              profile.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))
            }
            <li>
              <a class="more" href="/about/">
                소개 더보기 <span aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </header>

    <div class="recent">
      {
        sections.map((section) => (
          <section aria-labelledby={`recent-${section.category}`}>
            <h2 class="section-label" id={`recent-${section.category}`}>
              <a href={section.href}>최근 {section.label} 글</a>
              <span class="count">전체 {section.total}편</span>
            </h2>
            <div class="list">
              {section.posts.length > 0 ? (
                <PostList posts={section.posts} />
              ) : (
                <p class="empty">아직 글이 없습니다.</p>
              )}
            </div>
          </section>
        ))
      }
    </div>

    <p class="all">
      <a class="text-link" href="/posts/">전체 글 보기 <span aria-hidden="true">→</span></a>
    </p>
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: var(--space-7) var(--section-gap);
  }

  /* 사진 | 이름·한 줄 소개·링크 */
  .profile-card {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 36rem;
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
  }

  .avatar {
    flex-shrink: 0;
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    object-fit: cover;
  }

  .avatar-mark {
    display: grid;
    place-items: center;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .avatar-mark .ink {
    fill: var(--color-text);
  }

  .avatar-mark .sky {
    fill: var(--color-accent);
  }

  .identity {
    min-width: 0;
  }

  .name {
    font-size: var(--text-lg);
    font-weight: var(--weight-medium);
    line-height: var(--leading-tight);
    letter-spacing: var(--tracking-heading);
  }

  .tagline {
    margin-top: var(--space-1);
    font-size: var(--text-sm);
    line-height: var(--leading-snug);
    color: var(--color-text-muted);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-4);
    margin-top: var(--space-2);
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }

  .links a {
    display: inline-block;
    padding-block: var(--space-1);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .links a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .links .more {
    font-weight: var(--weight-medium);
    color: var(--color-accent);
  }

  /* 작은 라벨 + 개수 + 1px 선 */
  .section-label {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
    font-family: var(--font-sans);
    font-size: var(--text-label);
    font-weight: var(--weight-medium);
    line-height: var(--leading-snug);
    letter-spacing: var(--tracking-label);
    font-variant-numeric: tabular-nums;
  }

  .section-label a {
    text-decoration: none;
  }

  .section-label a:hover {
    color: var(--color-accent);
    text-decoration: underline;
  }

  .count {
    color: var(--color-text-muted);
  }

  /* 넓은 화면에서는 공부 | 일상 두 열 */
  .recent {
    display: grid;
    gap: var(--section-gap) var(--space-8);
  }

  .list {
    margin-top: var(--space-5);
  }

  .empty {
    color: var(--color-text-muted);
  }

  .all {
    margin-top: var(--space-8);
  }

  @media (min-width: 960px) {
    .recent {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
