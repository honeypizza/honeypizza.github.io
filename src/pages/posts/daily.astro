---
import ListLayout from '../../layouts/ListLayout.astro';
import { SITE } from '../../consts';
import { CATEGORIES, getPosts } from '../../lib/posts';

const { label: title } = CATEGORIES.daily;
const posts = await getPosts('daily');
---

<ListLayout
  title={title}
  description={`${title} 글 ${posts.length}편 — ${SITE.description}`}
  current="daily"
  posts={posts}
  category="daily"
/>
