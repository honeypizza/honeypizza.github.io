---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { CATEGORIES, getPosts } from '../../lib/posts';

const { label: title, description } = CATEGORIES.study;
const posts = await getPosts('study');
---

<BaseLayout title={title} description={description} current="study">
  <div class="container narrow">
    <header class="page-header">
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <PostArchive posts={posts} active="study" />
  </div>
</BaseLayout>
