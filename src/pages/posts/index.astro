---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostArchive from '../../components/PostArchive.astro';
import { SITE } from '../../consts';
import { getPosts } from '../../lib/posts';

const title = '전체 글';
const posts = await getPosts();
---

<BaseLayout title={title} description={`전체 글 ${posts.length}편 — ${SITE.description}`} current="posts">
  <div class="container narrow">
    <header class="page-header">
      <h1>{title}</h1>
      <a class="text-link" href="/tags/">태그 <span aria-hidden="true">→</span></a>
    </header>
    <PostArchive posts={posts} />
  </div>
</BaseLayout>

<style>
  /* 제목 왼쪽, 태그 모아 보기 링크는 같은 줄 오른쪽 끝 */
  .page-header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2) var(--space-5);
  }
</style>
